{
    "manifest_version": 3,
    "name": "Board Explorer",
    "version": "2.0.0",
    "description": "Turn static chessboards into playable chessboards! Real-time detection powered by YOLO11.",
    "permissions": ["webNavigation","desktopCapture","downloads","scripting","storage"],
    "author": "Reed Krawiec",
    "homepage_url": "https://github.com/reedkrawiec/Board-Explorer",
    "short_name": "Board Explorer",
    "icons":{
        "380":"images/icons/icon.png" 
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Board Explorer"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scripts/content-script.js"],
            "css":["css/chessground.css","css/theme.css"]
        }
    ],
    "web_accessible_resources": [{
        "resources":[
            "scripts/stockfish.js",
            "model/chess-yolo11.onnx",
            "scripts/*.wasm",
            "*.wasm"
        ],
        "matches":["<all_urls>"]
    }]
}
